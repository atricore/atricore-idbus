<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.atricore.idbus</groupId>
        <artifactId>all</artifactId>
        <version>1.7.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>org.atricore.idbus.bundles</groupId>
    <artifactId>org.atricore.idbus.bundles.redis-client-v3_10</artifactId>
    <version>1.7.0-SNAPSHOT</version>
    <packaging>bundle</packaging>
    <name>Atricore IDBus :: Bundle : Redis Client v3.10 OSGi</name>

    <properties>
        <jedis.version>3.10.0</jedis.version>
        <commons-pool2.version>2.11.1</commons-pool2.version>
        <idbus.kernel.version>1.7.0-SNAPSHOT</idbus.kernel.version>
        <felix.plugin.version>3.5.1</felix.plugin.version>
    </properties>

    <dependencies>
        <!-- Jedis Redis Client -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>${jedis.version}</version>
        </dependency>

        <!-- Commons Pool 2 for connection pooling -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
            <version>${commons-pool2.version}</version>
        </dependency>

        <!-- Provided dependencies -->
        <dependency>
            <groupId>org.atricore.idbus.kernel.common</groupId>
            <artifactId>org.atricore.idbus.kernel.common.support</artifactId>
            <version>${idbus.kernel.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.osgi.core</artifactId>
            <version>${spring.osgi.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.25</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.1.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <fork>${compiler.fork}</fork>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>${felix.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-Name>Atricore IDBus :: Bundle : Redis Client v3.10</Bundle-Name>
                        <Bundle-Description>Redis Client v3.10 OSGi Bundle with Jedis</Bundle-Description>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>

                        <!-- Export our API and wrapped libraries -->
                        <Export-Package>
                            org.atricore.idbus.bundles.redis.*;version={redis.version}
                            redis.clients.jedis.*;version=${jedis.version},
                            org.apache.commons.pool2.*;version=${commons-pool2.version},
                            org.atricore.idbus.bundles.redis.*;version=${project.version}
                        </Export-Package>

                        <Private-Package>!*</Private-Package>

                        <!-- Import required packages -->
                        <Import-Package>
                            org.apache.commons.logging; version="[1.0,1.1.99)"; provider=paxlogging,
                            org.apache.log4j; version="[1.2,1.3)"; provider=paxlogging,
                            org.slf4j; version="[1.7,2.0); resolution:=optional",
                            javax.net,
                            javax.net.ssl,
                            javax.security.auth.x500,
                            javax.security.sasl,
                            org.springframework.beans;resolution:=optional,
                            org.springframework.beans.factory;resolution:=optional,
                            org.springframework.context;resolution:=optional,
                            org.springframework.core;resolution:=optional
                        </Import-Package>
                        <Private-Package>!*</Private-Package>
                        <!-- Embed dependencies into bundle -->
                        <Embed-Dependency>
                            jedis;scope=compile;inline=false,
                            commons-pool2;scope=compile;inline=false
                        </Embed-Dependency>

                        <Embed-Transitive>false</Embed-Transitive>

                        <!-- Dynamic import for OSGi flexibility -->
                        <DynamicImport-Package>*</DynamicImport-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
